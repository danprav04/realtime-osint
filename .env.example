# ==============================================================================
# Real-Time OSINT Gathering Service - Environment Configuration
# ==============================================================================

# --- Core Security & Server ---
# Master API key for protecting backend endpoints and dashboard access
API_KEY=osint_secret_key_2026
ADMIN_PASSWORD=admin123
PUBLIC_DISPLAY_PASSWORD=osint-2026
PUBLIC_DISPLAY_SECRET=osint_viewer_secret_signing_key_2026
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Database & Cache (Default Docker Compose service hostnames) ---
POSTGRES_DB=osint
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@postgres:5432/osint
REDIS_URL=redis://redis:6379/0

# --- Frontend Endpoints (Used by Next.js Dashboard) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=http://localhost:8000

# --- Live AI Providers (Braced for Free Tier Limits) ---
# Gemini Free Tier: gemini-3.5-flash-lite (15 RPM / 500 RPD)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq Free Tier: qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b (30 RPM / 1,000 RPD)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Hugging Face Space TEI Embeddings Endpoint (Optional: Self-hosted 24/7 Semantic Map Embeddings)
# Example: https://your-username-osint-embeddings-tei.hf.space
HF_EMBEDDING_URL=
HF_API_KEY=

# --- Telegram Notification Bot ---
# Bot token from @BotFather; if chat_id is left blank, send /start to your bot for auto-discovery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_THRESHOLD=7

# --- Optional Source Ingestion Credentials (Public fallbacks used if blank) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
