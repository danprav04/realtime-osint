# ==============================================================================
# Real-Time OSINT Gathering Service - Environment Configuration
# ==============================================================================

# --- Core Security & Server ---
# Master API key for protecting backend endpoints and dashboard access
API_KEY=osint_secret_key_2026
ADMIN_PASSWORD=admin123
PUBLIC_DISPLAY_PASSWORD=osint-2026
PUBLIC_DISPLAY_SECRET=osint_viewer_secret_signing_key_2026
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Database & Cache (Default Docker Compose service hostnames) ---
POSTGRES_DB=osint
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@postgres:5432/osint
REDIS_URL=redis://redis:6379/0

# --- Frontend Endpoints (Used by Next.js Dashboard) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=http://localhost:8000

# --- Live AI Providers (Braced for Free Tier Limits) ---
# Gemini Free Tier: gemini-3.5-flash-lite (15 RPM / 500 RPD)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq Free Tier: qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b (30 RPM / 1,000 RPD)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# AI Hub Mix Free Tier: coding-glm-5.3-free (10 RPM / 100 RPD / 1M TPD)
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1

# Mistral AI: Free Plan ($10/mo allowance, 12.5 RPS on ministral-3b, 3.13 RPS on ministral-8b)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Cloudflare Workers AI: 10,000 Neurons/day free (~4,100 RPD on 1B, ~2,200 RPD on 8B)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Z.ai / Zhipu AI ($0 Flash models, unlimited RPD/TPD, 1-5 concurrency)
ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# SiliconFlow ($0 open weights catalog, ~1000 RPM per model, international endpoint)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1

# Hugging Face Space TEI Embeddings Endpoint (Optional: Self-hosted 24/7 Semantic Map Embeddings)
# Example: https://your-username-osint-embeddings-tei.hf.space
HF_EMBEDDING_URL=
HF_API_KEY=

# --- Telegram Notification Bot ---
# Bot token from @BotFather; if chat_id is left blank, send /start to your bot for auto-discovery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_THRESHOLD=7

# --- Optional Source Ingestion Credentials (Public fallbacks used if blank) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Optional Production Deployment (Used by deploy.ps1) ---
DEPLOY_REMOTE_HOST=production
DEPLOY_REMOTE_USER=ubuntu
DEPLOY_REMOTE_DIR=/home/ubuntu/deployments/realtime-osint
DEPLOY_TAILSCALE_IP=
